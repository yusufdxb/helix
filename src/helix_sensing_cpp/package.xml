<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>helix_sensing_cpp</name>
  <version>0.1.0</version>
  <description>
    C++ rclcpp_lifecycle port of the HELIX anomaly detector. Drop-in
    replacement for the Python helix_core.anomaly_detector node:
    same node name (helix_anomaly_detector), same parameters, same
    topics (/diagnostics, /helix/metrics -> /helix/faults), same
    FaultEvent strings (detail and rounded context values, byte for byte),
    same emit_cooldown_s / min_anomaly_duration_s gates. Selected with
    helix_bringup's anomaly_backend:=cpp; the Python node stays the default.
  </description>
  <maintainer email="yusuf.a.guenena@gmail.com">yusufdxb</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>helix_msgs</depend>

  <!-- Launched by helix_bringup (helix_sensing.launch.py anomaly_backend:=cpp),
       which also owns the shared helix_params.yaml; this package ships no
       launch file or config copy, so it does not depend on helix_bringup. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <!-- The Python reference implementation, run side by side with the core
       by test/test_python_parity.py. -->
  <test_depend>helix_core</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
